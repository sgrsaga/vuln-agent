ANTHROPIC_API_KEY=sk-ant-...

# GitHub integration — set these when running outside GitHub Actions
GITHUB_TOKEN=ghp_...
GITHUB_REPO=owner/repo          # e.g. myorg/my-infra
GHCR_NAMESPACE=ghcr.io/myorg   # push remediated images here; omit for local-only

# Discovery mode — namespace selection (whitelist takes priority over blacklist)
# and whether to also scan init container images. Also settable via
# --namespaces/--exclude-namespaces CLI flags on a per-run basis.
TARGET_NAMESPACES=              # comma-separated whitelist, e.g. argocd,monitoring
EXCLUDED_NAMESPACES=            # comma-separated blacklist, used only when TARGET_NAMESPACES is empty
INCLUDE_INIT_CONTAINERS=false

# Optional
MAX_ITERATIONS=5
OUTPUT_DIR=output
ALLOW_MAJOR_TAG_BUMP=false     # allow crossing a major version when hunting for a fixed upstream tag

# Discovery mode only — skip rescanning images unchanged since their last scan
RESCAN_INTERVAL_DAYS=7         # rescan an unchanged image again after this many days
FORCE_RESCAN=false              # ignore tracked state and rescan everything this run

# Higher-environment promotion (PR-bot) — opens a reviewable PR bumping the
# optimized image reference in a separate GitOps manifests repo. Leave
# GITOPS_REPO unset to disable (for lower environments, use ArgoCD Image
# Updater instead — see README).
GITOPS_REPO=                    # owner/repo of the GitOps manifests repo, e.g. myorg/gitops-ppe
GITOPS_TOKEN=                   # PAT with repo access to GITOPS_REPO; falls back to GITHUB_TOKEN if unset
GITOPS_BASE_BRANCH=main
GITOPS_IMAGE_PATH_TEMPLATE=     # path within GITOPS_REPO, e.g. environments/ppe/{repo_name}/values.yaml

# Base image hardening ("golden image" generation) — ONLY ever attempted for
# images matching OWNED_IMAGE_LABEL_SELECTOR (a k8s label selector, discovery
# mode only) with enough config to locate the source/tests. Never attempted
# for third-party/vendor images — see README's "Base image hardening" section.
#
# Self-service alternative to HARDENING_CONFIG below: an owned app's own
# Deployment can carry vuln-agent.io/source-repo, vuln-agent.io/dockerfile-path,
# vuln-agent.io/test-stage (or vuln-agent.io/test-command) annotations instead —
# no central config needed at all. Annotation values win over a HARDENING_CONFIG
# entry for the same repo when both are present.
OWNED_IMAGE_LABEL_SELECTOR=     # e.g. vuln-agent.io/harden=true
HARDENING_CONFIG=[]             # JSON list: [{"repo","sourceRepo","dockerfilePath","testStage"|"testCommand"}]
HARDENING_MAX_CANDIDATES=3
HARDEN_BASE_IMAGE=false         # single-image mode only opt-in (--harden); discovery mode uses the label selector instead
