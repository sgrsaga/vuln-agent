ANTHROPIC_API_KEY=sk-ant-...

# GitHub integration — set these when running outside GitHub Actions
GITHUB_TOKEN=ghp_...
GITHUB_REPO=owner/repo          # e.g. myorg/my-infra
GHCR_NAMESPACE=ghcr.io/myorg   # push remediated images here; omit for local-only

# Optional
MAX_ITERATIONS=5
OUTPUT_DIR=output
